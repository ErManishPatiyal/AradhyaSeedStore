# Supabase — create a free project at https://supabase.com
# Copy this file to .env.local in packages/pwa and packages/mobile (or root)

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# PWA (Next.js) — prefix with NEXT_PUBLIC_ for client-side access
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Mobile (Expo) — prefix with EXPO_PUBLIC_ for client-side access
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
